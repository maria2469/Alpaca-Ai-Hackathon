# Secrets. Never commit a real credential.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Local artifacts
*.log
logs/
.DS_Store

# Surge pages are local build output, except the paca-cycles dashboard source.
# (surge_artifacts/* not surge_artifacts/ — git cannot re-include files under an
# excluded directory.) Data copies in paca-cycles/ (json, jsonl) stay ignored.
surge_artifacts/*
!surge_artifacts/paca-cycles/
surge_artifacts/paca-cycles/*
!surge_artifacts/paca-cycles/index.html
!surge_artifacts/paca-cycles/deploy.sh
!surge_artifacts/paca-cycles/CNAME
!surge_artifacts/paca-candles/
surge_artifacts/paca-candles/*
!surge_artifacts/paca-candles/index.html
!surge_artifacts/paca-candles/deploy.sh
!surge_artifacts/paca-candles/CNAME
!surge_artifacts/paca-deck/
surge_artifacts/paca-deck/*
!surge_artifacts/paca-deck/index.html
!surge_artifacts/paca-deck/deploy.sh
!surge_artifacts/paca-deck/CNAME
!surge_artifacts/paca-deck/export_deck_data.py
